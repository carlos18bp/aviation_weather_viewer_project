DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=aviation_weather
POSTGRES_USER=aviation_weather
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional: source database used to create PostGIS-enabled test databases.
# Defaults to POSTGRES_DB, which must already have the postgis extension.
POSTGRES_TEST_TEMPLATE=aviation_weather
